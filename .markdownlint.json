# Konfigurasi markdownlint untuk LabManage
default: true

# Mengizinkan elemen HTML pada markdown (seperti <p align="center"> untuk banner & badge)
MD033: false

# Mengizinkan baris panjang untuk tabel dan badge
MD013: false

# Mengizinkan first line bukan H1 (karena diawali banner gambar terpusat)
