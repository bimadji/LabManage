# Variabel Lingkungan Publik Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Kunci Rahasia Layanan Supabase (Hanya untuk server-side & skrip seeder, jangan beri awalan NEXT_PUBLIC)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Mode demo: tampilkan data contoh tanpa database. Default mati; jangan nyalakan di produksi.
NEXT_PUBLIC_DEMO_MODE=false

# --- DB UJI LOKAL (opsional) ---
# Dipakai scripts/test-rls.ts dan scripts/test-inventory-admin.ts.
# WAJIB menunjuk Supabase lokal (http://127.0.0.1:PORT), BUKAN *.supabase.co:
# skrip menulis data uji dan menolak URL produksi.
# Salin nilainya dari `npx supabase status -o env` setelah `npx supabase start`.
SUPABASE_TEST_URL=http://127.0.0.1:54521
SUPABASE_TEST_ANON_KEY=your-local-anon-key
