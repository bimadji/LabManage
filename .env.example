# Daftar semua variabel env LabManage. Salin ke file .env di folder yang sesuai.
# Nilai lokal diambil dari `npx supabase status -o env`. Jangan commit nilai rahasia.

# api/.env (dan api/.env.test untuk test, wajib mengarah ke 127.0.0.1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000

# web/.env (hanya anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
